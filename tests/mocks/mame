#!/bin/bash
# Stand-in MAME binary: identity, configuration, -listxml and one behaviour per set name.
case "$1" in
	-version)    echo "0.999 (mock)"; exit 0 ;;
	-showconfig) echo "rompath                   $MOCK_ROMPATH"; exit 0 ;;
	-listxml)    cat "$(dirname "$0")/listxml.xml"; exit 0 ;;
esac
echo "$@" > "$(dirname "$MAMECREDITS_OUT")/args"
case "$1" in
	ok|okclone) printf 'status=found\nreason=boot_only\n' > "$MAMECREDITS_OUT" ;;
	missing)    exit 2 ;;
	crash)      echo "fatal"; exit 3 ;;
	hang)       exec sleep 60 ;;
esac
exit 0
